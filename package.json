{
  "name": "react-media-kit",
  "version": "0.3.0",
  "description": "Headless, unstyled React video player primitives",
  "type": "module",
  "license": "MIT",
  "author": "Marek Miklaszewski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Balldoro/react-media-kit.git"
  },
  "homepage": "https://react-media-kit.com",
  "bugs": {
    "url": "https://github.com/Balldoro/react-media-kit/issues"
  },
  "keywords": [
    "react",
    "video",
    "video-player",
    "media",
    "audio",
    "player",
    "headless",
    "UI",
    "typescript"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "prepare": "husky",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "size-limit": [
    {
      "name": "Bundle size (gzip)",
      "path": "dist/*.js",
      "gzip": true,
      "disablePlugins": [
        "@size-limit/esbuild"
      ],
      "limit": "12 KB"
    },
    {
      "name": "Bundle size (gzip, from source)",
      "path": "src/index.ts",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime"
      ],
      "limit": "12 KB"
    }
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@size-limit/esbuild-why": "^13.0.3",
    "@size-limit/file": "^13.0.3",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
